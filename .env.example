POSTGRES_USER=shp
POSTGRES_PASSWORD=shp
POSTGRES_DB=shp
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# LLM_PROVIDER: "groq" (default — hosted, fast, free tier, no local setup)
#            or "ollama" (local, offline, needs Docker + a model pulled)
LLM_PROVIDER=groq

# Groq (get a free key at https://console.groq.com/keys, no credit card needed)
GROQ_API_KEY=
GROQ_MODEL_MONITOR=openai/gpt-oss-20b
GROQ_MODEL_FIX=openai/gpt-oss-120b

# Only used if LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Free public API, no key required (Open-Meteo)
DATA_SOURCE_URL=https://api.open-meteo.com/v1/forecast?latitude=24.86&longitude=67.01&hourly=temperature_2m,relative_humidity_2m,precipitation

# GitHub repo the Fix Agent will open PRs against (Stage 4)
GITHUB_REPO=your-username/self-healing-pipeline
GITHUB_TOKEN=
