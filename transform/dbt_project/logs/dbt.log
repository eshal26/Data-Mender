  create view "shp"."public"."stg_weather__dbt_tmp"
    
    
  as (
    -- Cleans raw_weather: casts types, drops obviously bad rows.
-- This is the model that breaks first when --break bad_column or
-- --break schema_drift is used upstream — good starting point for the
-- Monitor Agent to point at in Stage 1.
