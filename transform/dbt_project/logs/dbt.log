    case
        when humidity_pct ~ '^-?\d+(\.\d+)?$' then humidity_pct::numeric
        else null
    end as humidity_pct,
    case
        when precipitation_mm ~ '^-?\d+(\.\d+)?$' then precipitation_mm::numeric
        else null
    end as precipitation_mm,
    loaded_at
from "shp"."public"."raw_weather"
where ts is not null
  );
