  create view "shp"."staging_verify"."stg_weather__dbt_tmp"
    
    
  as (
    -- Cleans raw_weather: casts types, drops obviously bad rows.
-- This is the model that breaks first when --break bad_column or
-- --break schema_drift is used upstream -- good starting point for the
-- Monitor Agent to point at in Stage 1.
select
    ts::timestamp              as ts,
    case
        when temperature_c ~ '^-?\d+(\.\d+)?$'
        then temperature_c::numeric
        else null
    end                         as temperature_c,
    humidity_pct::numeric      as humidity_pct,
    precipitation_mm::numeric  as precipitation_mm,
    loaded_at
from "shp"."public"."raw_weather"
where ts is not null
  );
